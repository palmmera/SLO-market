DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/slo_market?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3001"
APP_URL="http://localhost:3001"

# Optional — Google sign-in / create account (extra option alongside email)
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3001 (and your production URL)
# Authorized redirect URIs: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_WEBHOOK_SECRET_2="whsec_..."
# Two Stripe webhook endpoints must point to {APP_URL}/api/stripe/webhook:
# 1. "Listen to events on Connected accounts" — marketplace sales use Connect direct
#    charges, so checkout.session.completed, account.updated, charge.refunded, and
#    payment_intent.payment_failed fire on connected seller accounts.
# 2. "Listen to events on your account" — enhanced-description purchases are charged
#    on the platform account (checkout.session.completed, charge.refunded).
# Put one endpoint's signing secret in STRIPE_WEBHOOK_SECRET and the other's in
# STRIPE_WEBHOOK_SECRET_2 (order does not matter; the app tries both).
STRIPE_CONNECT_CLIENT_ID=""

STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SLO Market <noreply@slomarket.local>"

ADMIN_EMAIL="admin@slomarket.local"
ADMIN_PASSWORD="change-me"
